  "modules": [
    {
      "id": "e91154aa03e04b2f82f93e957af67524",
      "name": "sysinfo",
      "source": "\"\"\"What the system says about itself.\n\nOn a Linux PC, in the simulator and in the Linux executables, MicroPython is a program of the\noperating system: it reads /proc and runs commands with os.system. On a board the same calls\nanswer with what MicroPython knows: the heap and the flash.\n\"\"\"\nimport gc\nimport os\nimport sys\nimport time\n\nON_LINUX = sys.platform == \"linux\"\n_last_cpu = None\n\n\ndef _read(path):\n    with open(path) as f:\n        return f.read()\n\n\ndef host():\n    \"\"\"Host name, kernel and uptime, or the board's platform and time since start.\"\"\"\n    if ON_LINUX:\n        name = _read(\"/proc/sys/kernel/hostname\").strip()\n        kernel = _read(\"/proc/sys/kernel/osrelease\").strip()\n        seconds = int(float(_read(\"/proc/uptime\").split()[0]))\n        return \"%s  |  Linux %s  |  up %s\" % (name, kernel, duration(seconds))\n    return \"%s  |  MicroPython  |  up %s\" % (sys.platform, duration(time.ticks_ms() // 1000))\n\n\ndef duration(seconds):\n    days, seconds = divmod(seconds, 86400)\n    hours, seconds = divmod(seconds, 3600)\n    minutes = seconds // 60\n    if days:\n        return \"%dd %dh\" % (days, hours)\n    return \"%dh %02dm\" % (hours, minutes)\n\n\ndef cpu():\n    \"\"\"Percent of CPU busy since the last call, from /proc/stat; None where it cannot be read.\"\"\"\n    global _last_cpu\n    if not ON_LINUX:\n        return None\n    fields = [int(value) for value in _read(\"/proc/stat\").split(\"\\n\", 1)[0].split()[1:]]\n    idle = fields[3] + (fields[4] if len(fields) > 4 else 0)\n    total = sum(fields)\n    previous, _last_cpu = _last_cpu, (idle, total)\n    if previous is None or total == previous[1]:\n        return 0\n    return 100 - 100 * (idle - previous[0]) // (total - previous[1])\n\n\ndef cores():\n    if not ON_LINUX:\n        return 1\n    return _read(\"/proc/stat\").count(\"\\ncpu\")\n\n\ndef memory():\n    \"\"\"(used, total) in bytes: the PC's RAM from /proc/meminfo, or MicroPython's heap.\"\"\"\n    if ON_LINUX:\n        info = {}\n        for line in _read(\"/proc/meminfo\").split(\"\\n\"):\n            parts = line.split()\n            if len(parts) >= 2:\n                info[parts[0].rstrip(\":\")] = int(parts[1]) * 1024\n        total = info[\"MemTotal\"]\n        return total - info.get(\"MemAvailable\", info[\"MemFree\"]), total\n    gc.collect()\n    free, used = gc.mem_free(), gc.mem_alloc()\n    return used, free + used\n\n\ndef disk_path():\n    \"\"\"The root on the PC; on a board the flash, which the STM32 boards mount at /flash.\"\"\"\n    if ON_LINUX:\n        return \"/\"\n    try:\n        return \"/flash\" if \"flash\" in os.listdir(\"/\") else \"/\"\n    except OSError:\n        return \"/\"\n\n\ndef disk(path):\n    \"\"\"(used, total) in bytes of the filesystem holding path, as df counts them; (0, 0) if unknown.\"\"\"\n    try:\n        stat = os.statvfs(path)\n    except (OSError, AttributeError):\n        return 0, 0\n    size = stat[1] or stat[0]\n    used = (stat[2] - stat[3]) * size\n    return used, used + stat[4] * size\n\n\ndef size(value):\n    for unit in (\"B\", \"KB\", \"MB\", \"GB\", \"TB\"):\n        if value < 1024 or unit == \"TB\":\n            return (\"%d %s\" if unit == \"B\" else \"%.1f %s\") % (value, unit)\n        value /= 1024\n\n\ndef processes(count=5):\n    \"\"\"The busiest processes, from ps run through os.system; a sentence where there is no shell.\"\"\"\n    if not hasattr(os, \"system\"):\n        return \"No operating system here: this button needs the PC.\"\n    out = \"/tmp/lms_sysmon_ps.txt\"\n    # %CPU of ps is the average over each process's life; ps itself is left out.\n    if os.system(\"ps -eo pcpu,rss,comm --sort=-pcpu --no-headers > %s 2>&1\" % out):\n        return \"ps did not run.\"\n    lines = []\n    for line in _read(out).split(\"\\n\"):\n        parts = line.split(None, 2)\n        if len(parts) == 3 and parts[2] != \"ps\" and len(lines) < count:\n            lines.append(\"%s %%  CPU   %s   %s\" % (parts[0], size(int(parts[1]) * 1024), parts[2]))\n    os.remove(out)\n    return \"\\n\".join(lines)\n"
    }
  ]
}
