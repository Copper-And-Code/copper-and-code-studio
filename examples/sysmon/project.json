  "code": {
    "module": "import sysinfo\n\nseries = None\ndisk_path = sysinfo.disk_path()\n\n\ndef gauge(arc, value_label, detail_label, percent, detail):\n    arc.set_value(percent)\n    value_label.set_text(\"%d %%\" % percent)\n    detail_label.set_text(detail)\n\n\ndef setup():\n    global series\n    series = ui.history.get_series_next(None)\n    for arc in (ui.cpu_arc, ui.mem_arc, ui.disk_arc):\n        arc.remove_style(None, lv.PART.KNOB)          # a gauge, not a control\n        arc.remove_flag(lv.obj.FLAG.CLICKABLE)\n    ui.history.set_style_size(0, 0, lv.PART.INDICATOR)               # a line, no dots\n    ui.history.set_style_border_width(0, 0)\n    ui.history.set_style_line_color(lv.color_hex(0x2C3E50), lv.PART.MAIN)  # the grid\n    ui.history.set_all_values(series, 0)\n    ui.disk_caption.set_text(\"Disk \" + disk_path)\n    sysinfo.cpu()                                     # the first reading only sets the start\n    refresh()\n\n\ndef refresh():\n    ui.host.set_text(sysinfo.host())\n    percent = sysinfo.cpu()\n    if percent is None:\n        ui.cpu_arc.set_value(0)\n        ui.cpu_value.set_text(\"n/a\")\n        ui.cpu_detail.set_text(\"not measured on a board\")\n    else:\n        gauge(ui.cpu_arc, ui.cpu_value, ui.cpu_detail, percent, \"%d cores\" % sysinfo.cores())\n        ui.history.set_next_value(series, percent)\n    used, total = sysinfo.memory()\n    gauge(ui.mem_arc, ui.mem_value, ui.mem_detail, 100 * used // total,\n          \"%s of %s\" % (sysinfo.size(used), sysinfo.size(total)))\n    used, total = sysinfo.disk(disk_path)\n    if total:\n        gauge(ui.disk_arc, ui.disk_value, ui.disk_detail, 100 * used // total,\n              \"%s of %s\" % (sysinfo.size(used), sysinfo.size(total)))\n    else:\n        ui.disk_value.set_text(\"n/a\")\n",
    "handlers": {
      "main_screen_loaded": {
        "widget": "main",
        "event": "SCREEN_LOADED",
        "body": "setup()"
      },
      "tick_tick": {
        "widget": "tick",
        "event": "TICK",
        "body": "refresh()"
      },
      "processes_clicked": {
        "widget": "processes",
        "event": "CLICKED",
        "body": "ui.processes_out.set_text(sysinfo.processes())"
      }
    }
  },
